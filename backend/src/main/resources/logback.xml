<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Switch to DEBUG to see repository-level detail from our own code -->
    <logger name="com.jobportal" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
